# Copy to .env.local for local development, or run: vercel env pull .env.local --environment development

# Postgres. On Vercel the Neon integration sets DATABASE_URL; DATABASE_URI also works locally.
DATABASE_URL=

# Long random string (openssl rand -hex 32). Required in production.
PAYLOAD_SECRET=

# CMS admin path segment. Must match the folder name under src/app/(payload)/.
PAYLOAD_ADMIN_ROUTE=

# Public origin for canonicals, sitemap, JSON-LD and llms.txt. localhost is always ignored.
NEXT_PUBLIC_SITE_URL=https://yitzjordan.dev

# Vercel Blob read/write token. Uploads go to local disk when empty.
BLOB_READ_WRITE_TOKEN=

# IndexNow key (8 to 128 letters, digits or hyphens). Served at /indexnow.txt. Production only.
INDEXNOW_KEY=

# Introduction emails (optional). Without RESEND_API_KEY or CONTACT_NOTIFY_TO, introductions are
# stored in the CMS but not emailed. The EMAIL_FROM domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=site@yitzjordan.dev
CONTACT_NOTIFY_TO=
